      "op": "projectRelative",
      "input": {
        "file": "/a/src/b/src/c.js"
      },
      "expected": "src/c.js",
      "note": "The LAST project-dir match wins. Collapsing further than a first-match rule is the accepted trade for machine independence."
    },
